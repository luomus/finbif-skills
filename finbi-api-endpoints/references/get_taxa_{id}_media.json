  "operation": {
    "operationId": "TaxaController_getTaxonMedia",
    "parameters": [
      {
        "name": "id",
        "required": true,
        "in": "path",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "checklist",
        "required": false,
        "in": "query",
        "description": "Include taxa from the specified checklists (defaults to FinBIF master checklist)",
        "schema": {
          "default": "MR.1",
          "type": "string"
        }
      },
      {
        "name": "checklistVersion",
        "required": false,
        "in": "query",
        "description": "Checklist version to be used. Defaults to the latest version.",
        "schema": {
          "default": "current",
          "type": "string",
          "enum": [
            "current",
            "MR.424",
            "MR.425",
            "MR.426",
            "MR.427",
            "MR.428",
            "MR.484"
          ]
        }
      }
    ],
