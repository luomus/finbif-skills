        "name": "checklist",
        "required": false,
        "in": "query",
        "description": "Include taxa from the specified checklists (defaults to FinBIF master checklist)",
        "schema": {
          "default": "MR.1",
          "type": "string"
        }
      },
      {
        "name": "checklistVersion",
        "required": false,
        "in": "query",
        "description": "Checklist version to be used. Defaults to the latest version.",
        "schema": {
          "default": "current",
          "type": "string",
          "enum": [
